{
  "name": "pi-csb-buddy",
  "version": "0.1.4",
  "description": "Report presence and activity of pi claude-bridge sessions to a desktop buddy",
  "type": "module",
  "license": "MIT",
  "author": "Alec Puente",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icepuente/pi-csb-buddy.git"
  },
  "homepage": "https://github.com/icepuente/pi-csb-buddy#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "claude-bridge"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import jiti/register --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "jiti": "2.7.0",
    "pi-job-listener": "0.1.6",
    "typebox": "1.4.2",
    "typescript": "^5.5.4"
  }
}
